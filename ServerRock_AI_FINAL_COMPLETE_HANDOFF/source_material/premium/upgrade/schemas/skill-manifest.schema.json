{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://server-rock.example/spec/skill-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "source",
    "license",
    "compatibility",
    "permissions",
    "entrypoints"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "commitSha",
        "path",
        "contentSha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "commitSha": {
          "type": "string",
          "minLength": 12
        },
        "path": {
          "type": "string"
        },
        "contentSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "spdx": {
          "type": "string"
        },
        "evidenceUrl": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "os": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "linux"
            ]
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agentProtocols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "networkHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesystem": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execute": {
          "type": "boolean"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": [
        "instructions"
      ],
      "properties": {
        "instructions": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
