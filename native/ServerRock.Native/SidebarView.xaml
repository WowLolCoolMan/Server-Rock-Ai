<!-- Left sidebar (from main's SidebarView), restyled with the native/polish design tokens.
     Every row is an icon (fixed 18 px column, one icon font) plus a label so labels line up.
     Clicks are forwarded to MainPage as events (SidebarView.xaml.cs); MainPage reaches the
     named elements below through the *Control accessor properties. -->
<UserControl x:Class="ServerRock.Native.SidebarView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ServerRock.Native"
      Background="{StaticResource SidebarBrush}">
  <Grid x:Name="Root" Background="{StaticResource SidebarBrush}" Padding="15,18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="4,0,4,18">
      <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource BrandMarkBrush}">
        <TextBlock Text="◈" Foreground="{StaticResource BrandMarkInkBrush}" FontSize="{StaticResource SubtitleFontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
        <TextBlock x:Name="ProductName" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
        <TextBlock Text="Local AI workspace" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource MutedInkBrush}" />
      </StackPanel>
    </Grid>
    <!-- Segmented mode switch: the track is a soft line color; the selected half is a raised
         white segment (UiTheme.ApplySegmentState), the other half is flat muted text. -->
    <Border Grid.Row="1" Background="{StaticResource LineSoftBrush}" CornerRadius="11" Padding="3" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,*">
        <Button x:Name="ChatModeButton" Content="Chatbot" Click="ChatModeClick" Style="{StaticResource SegmentButtonStyle}" AutomationProperties.Name="Open Chat workspace" AutomationProperties.HelpText="Switch to the general chat workspace." />
        <Button x:Name="CodingModeButton" Grid.Column="1" Content="Coding Agent" Click="CodingModeClick" Style="{StaticResource SegmentButtonStyle}" AutomationProperties.Name="Open Coding Agent workspace" AutomationProperties.HelpText="Switch to the project-scoped coding workspace." />
      </Grid>
    </Border>
    <!-- Main's grouped panel behind the primary actions (rows 2–8). -->
    <Border Grid.Row="2" Grid.RowSpan="7" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="4,5" />
    <Button x:Name="NewConversationButton" Grid.Row="2" Style="{StaticResource SidebarActionButtonStyle}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="8,9,8,6" Click="NewChatClick" AutomationProperties.Name="Start a new conversation"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" Style="{StaticResource NavIconStyle}" /><TextBlock x:Name="NewConversationLabel" Text="New conversation" /></StackPanel></Button>
    <Button x:Name="ScheduledTasksButton" Grid.Row="3" Style="{StaticResource SidebarActionButtonStyle}" Click="ScheduledTasksClick" AutomationProperties.Name="Open activity and tasks" AutomationProperties.HelpText="Review recent operations, interrupted work, and future task controls."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE823;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Activity &amp; tasks" /></StackPanel></Button>
    <Button x:Name="ImagesButton" Grid.Row="4" Style="{StaticResource SidebarActionButtonStyle}" Click="ImagesClick" AutomationProperties.Name="Open images workspace" AutomationProperties.HelpText="Open Image Studio for local image generation."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEB9F;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Images" /></StackPanel></Button>
    <Button Grid.Row="5" Style="{StaticResource SidebarActionButtonStyle}" Click="PluginStoreClick" AutomationProperties.Name="Open plugin store" AutomationProperties.HelpText="Browse supported plugins, extensions, and skills."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEA86;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Extensions &amp; skills" /></StackPanel></Button>
    <Button Grid.Row="6" Style="{StaticResource SidebarActionButtonStyle}" Click="ModelClick" AutomationProperties.Name="Open AI SuperMarket and installed models" AutomationProperties.HelpText="Browse, download, select, pin, or benchmark compatible local models."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8F1;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Model store" /></StackPanel></Button>
    <Button x:Name="MoreButton" Grid.Row="7" Style="{StaticResource SidebarActionButtonStyle}" Click="MoreClick" ToolTipService.ToolTip="More options · projects, search, Code Review Agent, health scan" AutomationProperties.Name="Open more workspace options" AutomationProperties.HelpText="Show projects, search, Code Review Agent, health tools, and connection settings."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE712;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="More" /></StackPanel></Button>
    <!-- Kept hidden (as on main) so New project / Search stay reachable from More and code. -->
    <Button x:Name="NewProjectButton" Grid.Row="7" Visibility="Collapsed" Click="NewProjectClick" AutomationProperties.Name="Create or select a project" />
    <Button x:Name="SearchButton" Grid.Row="7" Visibility="Collapsed" Click="SearchClick" AutomationProperties.Name="Search saved conversations" />
    <Button Grid.Row="8" x:Name="GitHubButton" Style="{StaticResource SidebarActionButtonStyle}" Click="GitHubClick" AutomationProperties.Name="Connect GitHub and open repositories" AutomationProperties.HelpText="Sign in, choose or enter a repository, and clone it as a project for the Coding Agent."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE943;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="GitHub &amp; source control" /></StackPanel></Button>
    <ScrollViewer Grid.Row="9" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
      <StackPanel Spacing="5">
        <local:ProjectNavigationView x:Name="ProjectNavigationControl" />
        <local:ConversationNavigationView x:Name="ConversationNavigationControl"
                                           NewChatFolderRequested="OnNewChatFolderRequested"
                                           ImportChatsRequested="OnImportChatsRequested"
                                           ExportChatsRequested="OnExportChatsRequested"
                                           ExportMarkdownFolderRequested="OnExportMarkdownFolderRequested" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="5,10,5,2">
      <StackPanel Spacing="7">
        <!-- Connection status lives in the header pill and the composer label; this sidebar
             copy was a fourth repeat, so it stays collapsed (code still updates it). -->
        <StackPanel Orientation="Horizontal" Spacing="7" Visibility="Collapsed"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" /><TextBlock x:Name="ConnectionLabel" Text="Checking model" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource InkBrush}" /><TextBlock Text="· local history" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource MutedInkBrush}" /></StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <!-- Update notice (from main): shown only when an update is available; Auto width so the
               pet button keeps the full row when it is hidden. -->
          <Button x:Name="UpdateButton" Visibility="Collapsed" Click="UpdateClick" Style="{StaticResource ContextButtonStyle}" Background="{StaticResource AccentSoftBrush}" Foreground="{StaticResource AccentInkBrush}" HorizontalContentAlignment="Left" Content="↓　Update available" AutomationProperties.Name="Open available app update" AutomationProperties.HelpText="Review and install the available app update." />
          <!-- Pet controls: show/hide plus a clearly labelled "choose pet" icon (was a bare ···). -->
          <Button Grid.Column="1" x:Name="CompanionButton" Click="ToggleCompanionClick" Style="{StaticResource ContextButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Show pet companion" AutomationProperties.HelpText="Show or hide a local companion in this app window."><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE76E;" FontSize="{StaticResource BodyFontSize}" /><TextBlock x:Name="CompanionButtonLabel" Text="Show pet" /></StackPanel></Button>
          <Button Grid.Column="2" Click="CustomizeCompanionClick" Style="{StaticResource ContextButtonStyle}" ToolTipService.ToolTip="Choose pet" AutomationProperties.Name="Choose pet companion" AutomationProperties.HelpText="Choose which local companion to show."><FontIcon Glyph="&#xE70F;" FontSize="{StaticResource SmallFontSize}" /></Button>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
