<Page x:Class="ServerRock.Native.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ServerRock.Native"
      Background="{StaticResource CanvasBrush}" Loaded="MainPageLoaded" KeyDown="AppKeyDown">
  <Grid x:Name="AppRoot" ColumnDefinitions="276,*" Background="{StaticResource CanvasBrush}" SizeChanged="AppRootSizeChanged">
    <local:SidebarView x:Name="SidebarView" Grid.Column="0" />
    <Grid x:Name="MainContent" Grid.Column="1" RowDefinitions="58,Auto,*" Background="{StaticResource SurfaceBrush}">
      <local:MainPageHeader x:Name="MainPageHeaderControl" Grid.Row="0" AutomationProperties.Name="Open navigation menu" />

      <!-- Responsive contract: SizeChanged="CodingWorkspaceToolbarSizeChanged" -->
      <local:CodingWorkspaceBar x:Name="CodingWorkspaceBarControl" Grid.Row="1" />

      <Grid Grid.Row="2" x:Name="ChatSurface" RowDefinitions="*,Auto" Background="{StaticResource SurfaceBrush}">
        <Grid Grid.Row="0" x:Name="ChatViewHost">
          <local:ConversationSurface x:Name="ConversationSurfaceControl" AutomationProperties.Name="Connect a model" />
          <local:SplitConversationView x:Name="SplitConversationViewControl" Visibility="Collapsed" />
        </Grid>

      <!-- Composer input, status, command hints, and send actions live in their own control. -->
      <!-- Responsive contract: SizeChanged="ComposerToolbarSizeChanged" -->
      <!-- Accessibility contract: AutomationProperties.Name="View status history" -->
      <local:ComposerInputView x:Name="ComposerToolbarControl" Grid.Row="1" AutomationProperties.Name="Message composer" AutomationProperties.HelpText="Write a message. Press Enter to send, Shift+Enter for a new line, or Control+L from anywhere to focus this composer." />
      </Grid>
    </Grid>
    <local:AppearanceBackdropView x:Name="AppearanceBackdrop" Grid.ColumnSpan="2" />
    <!-- Drawer scrim: must stretch over the whole window. Without Stretch alignment the Button
         sized to nothing, so the content was never dimmed and clicking outside did not close it. -->
    <Button x:Name="SidebarBackdrop" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource ScrimBrush}" BorderThickness="0" CornerRadius="0" Visibility="Collapsed" Click="CloseSidebarClick" AutomationProperties.Name="Close navigation menu">
      <Button.Resources>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ScrimColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ScrimColor}" />
      </Button.Resources>
    </Button>
    <Canvas x:Name="CompanionOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Loaded="CompanionOverlayLoaded" SizeChanged="CompanionOverlaySizeChanged">
      <Border x:Name="CompanionCard" Width="230" Background="{x:Null}" BorderThickness="0" Padding="0" AutomationProperties.Name="Pet companion">
        <StackPanel HorizontalAlignment="Center" Spacing="4">
          <!-- Pet speech: a token-colored bubble in a fixed-height slot, so a longer message grows
               the bubble upward instead of pushing the sprite down. Hidden with Opacity, not
               Visibility, for the same reason. -->
          <Grid Height="56" IsHitTestVisible="False">
            <Border x:Name="CompanionSpeechBubble" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="9,5">
              <TextBlock x:Name="CompanionSpeech" Text="Ready for your next prompt." FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxLines="3" TextTrimming="CharacterEllipsis" MaxWidth="196" AutomationProperties.Name="Pet completion summary" />
            </Border>
          </Grid>
          <Grid Width="84" Height="84" HorizontalAlignment="Center">
            <!-- CompanionSprite carries the animation transform (MainPage.CompanionAnimation.cs);
                 CompanionImageFade holds the previous frame during a cross-fade. -->
            <Grid x:Name="CompanionSprite" Width="80" Height="80" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Image x:Name="CompanionImageFade" Stretch="Uniform" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
              <Image x:Name="CompanionImage" Stretch="Uniform" IsTabStop="True" ImageFailed="CompanionImageFailed" KeyDown="CompanionKeyDown" PointerPressed="CompanionPointerPressed" PointerMoved="CompanionPointerMoved" PointerReleased="CompanionPointerReleased" PointerCaptureLost="CompanionPointerCaptureLost" AutomationProperties.Name="Move companion sprite" AutomationProperties.HelpText="Drag the sprite to move it, or focus it and use the arrow keys. Hold Shift to move farther." />
            </Grid>
            <Button Content="×" Click="HideCompanionClick" Background="Transparent" Foreground="{StaticResource MutedInkBrush}" BorderThickness="0" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Hide pet companion" />
          </Grid>
          <TextBlock x:Name="CompanionName" Text="Percy" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Center" IsHitTestVisible="False" />
        </StackPanel>
      </Border>
    </Canvas>
  </Grid>
</Page>
