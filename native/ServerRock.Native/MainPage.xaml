<Page x:Class="ServerRock.Native.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#fbfcfb" Loaded="MainPageLoaded" KeyDown="AppKeyDown">
  <Grid x:Name="AppRoot" ColumnDefinitions="276,*" Background="#fbfcfb">
    <Grid x:Name="Sidebar" Grid.Column="0" Background="#f2f6f5" Padding="15,18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="4,0,4,18">
        <Border Width="34" Height="34" CornerRadius="11" Background="#183844">
          <TextBlock Text="◈" Foreground="#dff7fa" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Server Rock" FontSize="14" FontWeight="SemiBold" Foreground="#18313b" />
          <TextBlock Text="Local AI workspace" FontSize="11" Foreground="#718187" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="#e6eeec" CornerRadius="11" Padding="3" Margin="0,0,0,14">
        <Grid ColumnDefinitions="*,*">
          <Button x:Name="ChatModeButton" Content="Chatbot" Click="ChatModeClick" Background="#ffffff" Foreground="#17353e" BorderBrush="#d8e3e0" BorderThickness="1" CornerRadius="8" Padding="8,9" AutomationProperties.Name="Open Chat workspace" AutomationProperties.HelpText="Switch to the general chat workspace." />
          <Button x:Name="CodingModeButton" Grid.Column="1" Content="Coding Agent" Click="CodingModeClick" Background="Transparent" Foreground="#53676b" CornerRadius="8" Padding="8,9" AutomationProperties.Name="Open Coding Agent workspace" AutomationProperties.HelpText="Switch to the project-scoped coding workspace." />
        </Grid>
      </Border>
      <Button x:Name="NewConversationButton" Grid.Row="2" Content="＋　New chat" HorizontalContentAlignment="Left" Background="#ffffff" Foreground="#253f47" BorderBrush="#dce6e3" BorderThickness="1" CornerRadius="9" Padding="11,10" Margin="0,0,0,6" Click="NewChatClick" AutomationProperties.Name="Start a new conversation" />
      <Button x:Name="NewProjectButton" Grid.Row="3" Content="▱　New project" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#40575b" CornerRadius="8" Padding="10,8" Click="NewProjectClick" AutomationProperties.Name="Create or select a project" />
      <Button Grid.Row="4" Content="⌕　Search chats" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#40575b" CornerRadius="8" Padding="10,8" Click="SearchClick" AutomationProperties.Name="Search saved conversations" />
      <Button Grid.Row="5" Content="◉　Models" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#40575b" CornerRadius="8" Padding="10,8" Click="ModelClick" AutomationProperties.Name="Open AI SuperMarket and installed models" AutomationProperties.HelpText="Browse, download, select, pin, or benchmark compatible local models." />
      <Button Grid.Row="6" Content="⚙　Settings" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#40575b" CornerRadius="8" Padding="10,8" Click="SettingsClick" AutomationProperties.Name="Open model connection settings" />
      <Button x:Name="GitHubButton" Grid.Row="7" Content="⌘　GitHub" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#40575b" CornerRadius="8" Padding="10,8" Click="GitHubClick" AutomationProperties.Name="Connect GitHub and open repositories" />
      <ScrollViewer Grid.Row="8" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel Spacing="5">
          <StackPanel x:Name="CodingNavigationSection" Spacing="0" Visibility="Collapsed">
            <TextBlock Text="PROJECTS" FontSize="10" CharacterSpacing="110" Foreground="#798b8e" Margin="8,3,0,4" />
            <StackPanel x:Name="ProjectList" Spacing="3" />
          </StackPanel>
          <TextBlock x:Name="CodeFilesHeader" Text="PROJECT FILES" FontSize="10" CharacterSpacing="110" Foreground="#66818a" Margin="8,16,0,4" Visibility="Collapsed" />
          <StackPanel x:Name="ProjectFileList" Spacing="2" />
          <StackPanel x:Name="ChatNavigationSection" Spacing="0">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,16,4,4">
            <TextBlock Text="CONVERSATION FOLDERS" FontSize="10" CharacterSpacing="110" Foreground="#66818a" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="＋" Width="26" Height="26" Padding="0" CornerRadius="7" Background="Transparent" Foreground="#52727a" Click="NewChatFolderClick" AutomationProperties.Name="Create conversation folder" AutomationProperties.HelpText="Create a folder to organize chats and coding conversations." />
            <Button x:Name="ImportChatsButton" Grid.Column="2" Content="↓" Width="26" Height="26" Padding="0" CornerRadius="7" Background="Transparent" Foreground="#52727a" Click="ImportChatsClick" AutomationProperties.Name="Import saved chats" AutomationProperties.HelpText="Import a JSON conversation archive into this device." />
            <Button x:Name="ExportChatsButton" Grid.Column="3" Content="↑" Width="26" Height="26" Padding="0" CornerRadius="7" Background="Transparent" Foreground="#52727a" Click="ExportChatsClick" AutomationProperties.Name="Export saved chats" AutomationProperties.HelpText="Save your conversations as a portable JSON archive." />
          </Grid>
          <StackPanel x:Name="ChatFolderList" Spacing="3" />
          <TextBlock Text="UNFILED" FontSize="10" CharacterSpacing="110" Foreground="#66818a" Margin="8,16,0,4" />
          <StackPanel x:Name="RecentList" Spacing="3" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="9" BorderBrush="#dce6e3" BorderThickness="0,1,0,0" Padding="5,12,5,2">
        <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#d69a4b" /><TextBlock x:Name="ConnectionLabel" Text="Checking model" FontSize="11" Foreground="#294850" /><TextBlock Text="· local history" FontSize="11" Foreground="#66818a" /></StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="MainContent" Grid.Column="1" RowDefinitions="58,Auto,*" Background="#ffffff">
      <Grid x:Name="Header" Grid.Row="0" ColumnDefinitions="*,Auto" Padding="22,0" Background="#ffffff" BorderBrush="#e9eff0" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="New chat" FontSize="14" FontWeight="SemiBold" Foreground="#26373d" />
          <Border x:Name="ProjectBadge" Visibility="Collapsed" Background="#e8f5f6" BorderBrush="#d5e9eb" BorderThickness="1" CornerRadius="12" Padding="8,3"><TextBlock x:Name="ProjectBadgeText" Text="Project instructions on" FontSize="11" Foreground="#46666c" /></Border>
          <Border x:Name="ChatFolderBadge" Visibility="Collapsed" Background="#f0f3fb" BorderBrush="#dfe5f2" BorderThickness="1" CornerRadius="12" Padding="8,3"><TextBlock x:Name="ChatFolderBadgeText" Text="Folder" FontSize="11" Foreground="#53617c" /></Border>
          <Border x:Name="TemporaryBadge" Visibility="Collapsed" Background="#fff5e6" BorderBrush="#f1dfc2" BorderThickness="1" CornerRadius="12" Padding="8,3"><TextBlock Text="Temporary · not saved" FontSize="11" Foreground="#805d2c" /></Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="SettingsClick" Background="#f4f8f8" Foreground="#4d646a" BorderBrush="#e0e9ea" BorderThickness="1" CornerRadius="12" Padding="9,4" AutomationProperties.Name="Model connection settings">
            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse x:Name="HeaderConnectionDot" Width="7" Height="7" Fill="#d69a4b" /><TextBlock x:Name="HeaderConnectionLabel" Text="Checking" FontSize="11" /></StackPanel>
          </Button>
          <Button Content="＋" Click="NewChatClick" Style="{StaticResource ContextButtonStyle}" AutomationProperties.Name="New chat" />
        </StackPanel>
      </Grid>

      <Border x:Name="CodingWorkspaceBar" Grid.Row="1" Visibility="Collapsed" Background="#fafcfb" BorderBrush="#e7edeb" BorderThickness="0,0,0,1" Padding="22,9">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⌂" FontSize="15" Foreground="#15849a" VerticalAlignment="Center" />
              <TextBlock x:Name="WorkspaceProjectName" Text="Choose a project" FontSize="13" FontWeight="SemiBold" Foreground="#273a3d" VerticalAlignment="Center" />
              <Border Background="#edf5f2" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"><TextBlock x:Name="WorkspaceFolderCount" Text="No folders" FontSize="10" Foreground="#527068" /></Border>
            </StackPanel>
            <TextBlock x:Name="WorkspaceProjectPath" Text="Select a local folder to give the Coding Agent project context." FontSize="11" Foreground="#7b8b8d" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="ProjectFoldersButton" Grid.Column="1" Content="Choose project" Click="ProjectFoldersClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" />
          <Button x:Name="GitHubActionsButton" Grid.Column="2" Content="Commit / push" Visibility="Collapsed" Click="GitHubActionsClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Review GitHub changes and commit or push" />
          <Button x:Name="TerminalButton" Grid.Column="3" Content="Terminal" Visibility="Collapsed" Click="OpenTerminalClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Open project terminal" />
          <Button x:Name="UndoHistoryButton" Grid.Column="4" Content="Undo history" Click="UndoHistoryClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Review approved project file changes and undo" />
        </Grid>
      </Border>

      <Grid Grid.Row="2" x:Name="ChatSurface" RowDefinitions="*,Auto" Background="#ffffff">
        <StackPanel x:Name="WelcomePanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="14" MaxWidth="660" Margin="28,28,28,20">
          <TextBlock Text="◈" FontSize="29" Foreground="#20a9c0" HorizontalAlignment="Center" />
          <TextBlock x:Name="WelcomeTitle" Text="What can I help you with?" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#26373d" />
          <TextBlock x:Name="WelcomeSubtitle" Text="Chat with a model running on your computer, or turn on web search when you need current sources." FontSize="15" TextWrapping="Wrap" Foreground="#74858a" HorizontalAlignment="Center" TextAlignment="Center" />
          <Button x:Name="ConnectionSetupButton" Content="Connect a model" Click="SettingsClick" Background="#0eafc8" Foreground="#ffffff" CornerRadius="10" Padding="14,9" HorizontalAlignment="Center" Visibility="Collapsed" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="SuggestionOne" Content="Help me write" Click="SuggestionClick" Tag="Help me write" Style="{StaticResource SuggestionButtonStyle}" AutomationProperties.Name="Use writing prompt suggestion" />
            <Button x:Name="SuggestionTwo" Content="Plan a project" Click="SuggestionClick" Tag="Help me plan a project" Style="{StaticResource SuggestionButtonStyle}" AutomationProperties.Name="Use project planning prompt suggestion" />
            <Button x:Name="SuggestionThree" Content="Search the web" Click="SuggestionClick" Tag="Search the web for " Style="{StaticResource SuggestionButtonStyle}" AutomationProperties.Name="Use web search prompt suggestion" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="0" x:Name="ConversationScroll" Visibility="Collapsed" Padding="28,20">
          <StackPanel x:Name="ConversationMessages" Spacing="18" MaxWidth="860" HorizontalAlignment="Center" />
        </ScrollViewer>

      <StackPanel Grid.Row="1" MaxWidth="900" HorizontalAlignment="Center" Margin="24,0,24,18">
        <StackPanel x:Name="AttachmentList" Visibility="Collapsed" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" />
        <Border x:Name="RuntimeStatusBanner" Visibility="Collapsed" Background="#f3f8f9" BorderBrush="#dce8ea" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="RuntimeStatus" Text="" FontSize="12" Foreground="#526a70" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="72" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1" Content="×" Click="DismissRuntimeStatusClick" Background="Transparent" Foreground="#60777d" BorderThickness="0" Padding="6,2" AutomationProperties.Name="Dismiss status message" />
          </Grid>
        </Border>
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,0,8">
          <Button x:Name="ModelButton" Content="◉　Ollama　·　llama3.2　⌄" Click="ModelHotswapClick" Style="{StaticResource ContextButtonStyle}" AutomationProperties.Name="Switch pinned model" AutomationProperties.HelpText="Choose a pinned model for this chat. Use Manage models to pin or unpin models." />
          <Button x:Name="WebSearchButton" Grid.Column="1" Content="⌕　Web off" Click="WebSearchClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" AutomationProperties.Name="Toggle web search" />
          <Button x:Name="TemporaryButton" Grid.Column="2" Content="◌　Temporary off" Click="TemporaryClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" AutomationProperties.Name="Toggle temporary chat" />
          <Button x:Name="ProjectFilesButton" Grid.Column="3" Content="▤　Project files off" Click="ProjectFilesClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Toggle project files in Chat" />
          <Button x:Name="CancelEditButton" Grid.Column="4" Content="Cancel edit" Click="CancelEditClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Cancel editing this message" />
          <Button Grid.Column="6" Content="Advanced" Click="AdvancedClick" Style="{StaticResource ContextButtonStyle}" Margin="8,0,0,0" AutomationProperties.Name="Open advanced generation controls" />
        </Grid>
        <Border x:Name="CommandHintPanel" Visibility="Collapsed" Background="#ffffff" BorderBrush="#dce8ea" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,0,8">
          <StackPanel Spacing="4">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="CommandSuggestions" Spacing="2" />
            </ScrollViewer>
            <TextBlock Text="↑ ↓ navigate　·　Enter complete　·　Esc close" FontSize="10" Foreground="#7a8e94" Margin="8,2,8,3" />
          </StackPanel>
        </Border>
        <Border x:Name="ComposerBorder" Background="#ffffff" BorderBrush="#dce4e6" BorderThickness="1" CornerRadius="17" Padding="14,10">
          <Grid RowDefinitions="Auto,Auto">
            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="150" PlaceholderText="Ask anything…" Background="Transparent" BorderThickness="0" Foreground="#283b41" TextChanged="PromptTextChanged" AutomationProperties.Name="Message composer" AutomationProperties.HelpText="Write a message. Press Enter to send, Shift+Enter for a new line, or Control+L from anywhere to focus this composer." />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0">
              <Button Content="＋" Click="AttachClick" Style="{StaticResource ComposerButtonStyle}" AutomationProperties.Name="Attach a file" />
              <Button Grid.Column="1" Content="/" Click="CommandsClick" Style="{StaticResource ComposerButtonStyle}" Margin="5,0,0,0" AutomationProperties.Name="Slash commands" />
              <TextBlock Grid.Column="2" x:Name="ProcessingLabel" Text="● Local model" Foreground="#53818a" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
              <Button x:Name="StopButton" Grid.Column="3" Content="■" Click="StopClick" Background="#a64d43" Foreground="#ffffff" CornerRadius="10" Width="34" Height="34" Visibility="Collapsed" AutomationProperties.Name="Stop generating response" />
              <Button x:Name="SendButton" Grid.Column="3" Content="↑" Click="SendClick" Background="#0eafc8" Foreground="#ffffff" CornerRadius="10" Width="34" Height="34" AutomationProperties.Name="Send message" />
            </Grid>
          </Grid>
        </Border>
        <TextBlock x:Name="PrivacyFootnote" Text="Your prompt goes to the model server shown above. Web search is off until you enable it." FontSize="11" Foreground="#8b999d" HorizontalAlignment="Center" Margin="0,9,0,0" TextAlignment="Center" />
      </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Page>
