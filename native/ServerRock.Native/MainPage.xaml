<Page x:Class="ServerRock.Native.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111210">
  <Grid ColumnDefinitions="56,260,*" Background="#111210">
    <Grid Grid.Column="0" Background="#151613" Padding="8,14" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
      <Border Width="34" Height="34" CornerRadius="11" Background="#a9c18b" HorizontalAlignment="Center" Margin="0,0,0,18">
        <TextBlock Text="◈" Foreground="#1c2118" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Button Grid.Row="1" Content="⌂" Tag="chat" Click="NavigateClick" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Chats" />
      <Button Grid.Row="2" Content="▧" Tag="images" Click="NavigateClick" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Images" />
      <Button Grid.Row="3" Content="◷" Tag="activity" Click="NavigateClick" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Activity" />
      <Button Grid.Row="5" Content="⚙" Click="SettingsClick" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="Settings" />
      <Border Grid.Row="6" Width="30" Height="30" CornerRadius="15" Background="#4d5943" HorizontalAlignment="Center" Margin="0,14,0,0">
        <TextBlock Text="SR" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
    <Grid Grid.Column="1" Background="#191a17" Padding="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
      <Button x:Name="ModeButton" Content="ChatBot　⌄" HorizontalContentAlignment="Left" Background="#292a26" CornerRadius="9" Padding="10,8" Click="ModeClick" />
      <Button Grid.Row="1" Content="＋　New chat" HorizontalContentAlignment="Left" Background="#262722" CornerRadius="9" Padding="10,9" Margin="0,18,0,16" Click="NewChatClick" />
      <TextBlock Grid.Row="2" Text="WORKSPACE" FontSize="11" CharacterSpacing="120" Foreground="#909188" Margin="7,4,0,8" />
      <Button Grid.Row="3" Content="＋　New project" HorizontalContentAlignment="Left" Foreground="#c7c9be" Padding="8,8" Click="NewProjectClick" />
      <StackPanel Grid.Row="4" x:Name="ProjectList" />
      <TextBlock Grid.Row="5" Text="RECENTS" FontSize="11" CharacterSpacing="120" Foreground="#909188" Margin="7,16,0,8" />
      <StackPanel Grid.Row="6" x:Name="RecentList" />
      <Border Grid.Row="7" VerticalAlignment="Bottom" BorderBrush="#34352f" BorderThickness="0,1,0,0" Padding="4,12">
        <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="8" Height="8" Fill="#77b487" /><TextBlock Text="On this device" Foreground="#c6c8bd" /><TextBlock Text="· private" Foreground="#85877e" /></StackPanel>
      </Border>
    </Grid>
    <Grid Grid.Column="2" RowDefinitions="52,*,Auto" Background="#111210">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,0" Background="#141512" BorderBrush="#292a26" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="New chat" FontSize="14" Foreground="#eeeae1" /><Border x:Name="ProjectBadge" Visibility="Collapsed" Background="#283026" BorderBrush="#465443" BorderThickness="1" CornerRadius="12" Padding="8,3"><TextBlock Text="Project context on" FontSize="11" Foreground="#c5d5b3" /></Border></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Border Background="#242722" CornerRadius="12" Padding="9,4"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="#77b487" /><TextBlock x:Name="ConnectionLabel" Text="Local" FontSize="12" /></StackPanel></Border><Button Content="＋" Click="NewChatClick" /></StackPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="ChatSurface">
        <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="620">
          <TextBlock Text="✳" FontSize="30" Foreground="#b3cd8b" HorizontalAlignment="Center" />
          <TextBlock Text="What are we building today?" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#eeeae1" />
          <TextBlock Text="Your workspace for local models, ideas, and making things." FontSize="15" Foreground="#999b91" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,0">
            <Button Content="Help me write a script" Click="SuggestionClick" Tag="Help me write a script" Style="{StaticResource SuggestionButtonStyle}" />
            <Button Content="Explain a codebase" Click="SuggestionClick" Tag="Explain a codebase" Style="{StaticResource SuggestionButtonStyle}" />
            <Button Content="Brainstorm an image prompt" Click="SuggestionClick" Tag="Brainstorm an image prompt" Style="{StaticResource SuggestionButtonStyle}" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="ConversationScroll" Visibility="Collapsed" Padding="28,20">
          <StackPanel x:Name="ConversationMessages" Spacing="18" MaxWidth="820" HorizontalAlignment="Center" />
        </ScrollViewer>
      </Grid>
      <StackPanel Grid.Row="2" MaxWidth="860" HorizontalAlignment="Center" Margin="24,0,24,18">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,8">
          <Button x:Name="ModelButton" Content="◉　Ollama　·　llama3.2　⌄" Click="ModelClick" Style="{StaticResource ContextButtonStyle}" />
          <TextBlock Grid.Column="2" x:Name="RuntimeStatus" Text="⌖　This device" FontSize="12" Foreground="#96988e" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <Button Grid.Column="3" Content="Advanced" Click="AdvancedClick" Style="{StaticResource ContextButtonStyle}" Margin="8,0,0,0" />
        </Grid>
        <Border Background="#20211d" BorderBrush="#3a3b35" BorderThickness="1" CornerRadius="16" Padding="14,10">
          <Grid RowDefinitions="Auto,Auto">
            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="150" PlaceholderText="Message your local model…" Background="Transparent" BorderThickness="0" KeyDown="PromptKeyDown" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,8,0,0">
              <Button Content="＋" Click="AttachClick" Style="{StaticResource ComposerButtonStyle}" />
              <Button Grid.Column="1" Content="▣　Chat" Click="ModeClick" Style="{StaticResource ComposerButtonStyle}" Margin="5,0,0,0" />
              <Button Grid.Column="2" Content="/" Click="HelpClick" Style="{StaticResource ComposerButtonStyle}" Margin="5,0,0,0" />
              <TextBlock Grid.Column="3" Text="● Local processing" Foreground="#9aab89" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
              <Button x:Name="StopButton" Grid.Column="4" Content="■" Click="StopClick" Background="#6b4039" Foreground="#fff2ed" CornerRadius="10" Width="34" Height="34" Visibility="Collapsed" />
              <Button x:Name="SendButton" Grid.Column="4" Content="↑" Click="SendClick" Background="#b3cd8b" Foreground="#22271c" CornerRadius="10" Width="34" Height="34" />
            </Grid>
          </Grid>
        </Border>
        <TextBlock Text="Model and project files stay on this device when using local connections." FontSize="11" Foreground="#85877e" HorizontalAlignment="Center" Margin="0,9,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
