<Page x:Class="ServerRock.Native.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource CanvasBrush}" Loaded="MainPageLoaded" KeyDown="AppKeyDown">
  <Grid x:Name="AppRoot" ColumnDefinitions="276,*" Background="{StaticResource CanvasBrush}" SizeChanged="AppRootSizeChanged">
    <Grid x:Name="Sidebar" Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="15,18" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
      <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="4,0,4,18">
        <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource BrandMarkBrush}">
          <TextBlock Text="◈" Foreground="{StaticResource BrandMarkInkBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="Server Rock" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
          <TextBlock Text="Local AI workspace" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource MutedInkBrush}" />
        </StackPanel>
      </Grid>
      <!-- Segmented mode switch: the track is a soft line color; the selected half is a raised
           white segment (UiTheme.ApplySegmentState), the other half is flat muted text. -->
      <Border Grid.Row="1" Background="{StaticResource LineSoftBrush}" CornerRadius="11" Padding="3" Margin="0,0,0,14">
        <Grid ColumnDefinitions="*,*">
          <Button x:Name="ChatModeButton" Content="Chatbot" Click="ChatModeClick" Style="{StaticResource SegmentButtonStyle}" AutomationProperties.Name="Open Chat workspace" AutomationProperties.HelpText="Switch to the general chat workspace." />
          <Button x:Name="CodingModeButton" Grid.Column="1" Content="Coding Agent" Click="CodingModeClick" Style="{StaticResource SegmentButtonStyle}" AutomationProperties.Name="Open Coding Agent workspace" AutomationProperties.HelpText="Switch to the project-scoped coding workspace." />
        </Grid>
      </Border>
      <!-- Sidebar navigation: every row is an icon (fixed 18 px column, one icon font) plus a label,
           so labels line up; the old text glyphs had different widths. "New chat" is the one raised
           row and stretches like the others. Labels that code changes have x:Name (…Label). -->
      <Button x:Name="NewConversationButton" Grid.Row="2" Style="{StaticResource SidebarActionButtonStyle}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,6" Click="NewChatClick" AutomationProperties.Name="Start a new conversation"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" Style="{StaticResource NavIconStyle}" /><TextBlock x:Name="NewConversationLabel" Text="New chat" /></StackPanel></Button>
      <Button Grid.Row="3" x:Name="NewProjectButton" Style="{StaticResource SidebarActionButtonStyle}" Click="NewProjectClick" AutomationProperties.Name="Create or select a project"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8F4;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="New project" /></StackPanel></Button>
      <Button Grid.Row="4" Style="{StaticResource SidebarActionButtonStyle}" Click="SearchClick" AutomationProperties.Name="Search saved conversations"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE721;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Search chats" /></StackPanel></Button>
      <Button Grid.Row="5" Style="{StaticResource SidebarActionButtonStyle}" Click="ModelClick" AutomationProperties.Name="Open AI SuperMarket and installed models" AutomationProperties.HelpText="Browse, download, select, pin, or benchmark compatible local models."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8F1;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Models" /></StackPanel></Button>
      <Button Grid.Row="6" Style="{StaticResource SidebarActionButtonStyle}" Click="SettingsClick" AutomationProperties.Name="Open settings"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Settings" /></StackPanel></Button>
      <Button Grid.Row="7" Style="{StaticResource SidebarActionButtonStyle}" Click="PluginStoreClick" AutomationProperties.Name="Open plugins" AutomationProperties.HelpText="See which plugins, extensions, and skills are built in or not available yet."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEA86;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="Plugins" /></StackPanel></Button>
      <Button Grid.Row="8" x:Name="GitHubButton" Style="{StaticResource SidebarActionButtonStyle}" Click="GitHubClick" AutomationProperties.Name="Connect GitHub and open repositories" AutomationProperties.HelpText="Sign in, choose or enter a repository, and clone it as a project for the Coding Agent."><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE943;" Style="{StaticResource NavIconStyle}" /><TextBlock Text="GitHub repositories" /></StackPanel></Button>
      <ScrollViewer Grid.Row="9" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
        <StackPanel Spacing="5">
          <StackPanel x:Name="CodingNavigationSection" Spacing="0" Visibility="Collapsed">
            <TextBlock Text="PROJECTS" Style="{StaticResource SectionLabelStyle}" Margin="8,3,0,4" />
            <StackPanel x:Name="ProjectList" Spacing="3" />
          </StackPanel>
          <TextBlock x:Name="CodeFilesHeader" Text="PROJECT FILES" Style="{StaticResource SectionLabelStyle}" Margin="8,16,0,4" Visibility="Collapsed" />
          <StackPanel x:Name="ProjectFileList" Spacing="2" />
          <StackPanel x:Name="ChatNavigationSection" Spacing="0">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="8,16,4,4">
            <TextBlock Text="CONVERSATION FOLDERS" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
            <!-- Folder tools: icons with tooltips (the bare ↓ ↑ arrows did not say import/export). -->
            <Button Grid.Column="1" Style="{StaticResource SidebarIconButtonStyle}" ToolTipService.ToolTip="New folder" Click="NewChatFolderClick" AutomationProperties.Name="Create conversation folder" AutomationProperties.HelpText="Create a folder to organize chats and coding conversations."><FontIcon Glyph="&#xE8F4;" FontSize="13" /></Button>
            <Button x:Name="ImportChatsButton" Grid.Column="2" Style="{StaticResource SidebarIconButtonStyle}" ToolTipService.ToolTip="Import chats from a file" Click="ImportChatsClick" AutomationProperties.Name="Import saved chats" AutomationProperties.HelpText="Import a JSON conversation archive into this device."><FontIcon Glyph="&#xE896;" FontSize="13" /></Button>
            <Button x:Name="ExportChatsButton" Grid.Column="3" Style="{StaticResource SidebarIconButtonStyle}" ToolTipService.ToolTip="Export chats to a file" Click="ExportChatsClick" AutomationProperties.Name="Export saved chats" AutomationProperties.HelpText="Save your conversations as a portable JSON archive."><FontIcon Glyph="&#xE898;" FontSize="13" /></Button>
          </Grid>
          <StackPanel x:Name="ChatFolderList" Spacing="3" />
          <TextBlock Text="UNFILED" Style="{StaticResource SectionLabelStyle}" Margin="8,16,0,4" />
          <StackPanel x:Name="RecentList" Spacing="3" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="5,10,5,2">
        <StackPanel Spacing="7">
          <!-- Connection status lives in the header pill and the composer label; this sidebar
               copy was a fourth repeat, so it stays collapsed (code still updates it). -->
          <StackPanel Orientation="Horizontal" Spacing="7" Visibility="Collapsed"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" /><TextBlock x:Name="ConnectionLabel" Text="Checking model" FontSize="11" Foreground="{StaticResource InkBrush}" /><TextBlock Text="· local history" FontSize="11" Foreground="{StaticResource MutedInkBrush}" /></StackPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <!-- Pet controls: show/hide plus a clearly labelled "choose pet" icon (was a bare ···). -->
            <Button x:Name="CompanionButton" Click="ToggleCompanionClick" Style="{StaticResource ContextButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" AutomationProperties.Name="Show pet companion" AutomationProperties.HelpText="Show or hide a local companion in this app window."><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE76E;" FontSize="14" /><TextBlock x:Name="CompanionButtonLabel" Text="Show pet" /></StackPanel></Button>
            <Button Grid.Column="1" Click="CustomizeCompanionClick" Style="{StaticResource ContextButtonStyle}" ToolTipService.ToolTip="Choose pet" AutomationProperties.Name="Choose pet companion" AutomationProperties.HelpText="Choose which local companion to show."><FontIcon Glyph="&#xE70F;" FontSize="13" /></Button>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="MainContent" Grid.Column="1" RowDefinitions="58,Auto,*" Background="{StaticResource SurfaceBrush}">
      <Grid x:Name="Header" Grid.Row="0" ColumnDefinitions="*,Auto" Padding="22,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="ToggleSidebarButton" Width="34" Height="34" Padding="0" Visibility="Collapsed" Click="ToggleSidebarClick" Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource MutedInkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9" ToolTipService.ToolTip="Navigation · Ctrl+Shift+E" AutomationProperties.Name="Open navigation menu" AutomationProperties.HelpText="Show chats, projects, models, and settings. On compact windows, press Control+Shift+E to open or close navigation; press Escape to close."><FontIcon Glyph="&#xE700;" FontSize="14" /></Button>
          <TextBlock x:Name="PageTitle" Text="New chat" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
          <Border x:Name="ProjectBadge" Visibility="Collapsed" Background="#e8f5f6" BorderBrush="#d5e9eb" BorderThickness="1" CornerRadius="12" Padding="8,3"><TextBlock x:Name="ProjectBadgeText" Text="Project instructions on" FontSize="11" Foreground="#46666c" /></Border>
          <Border x:Name="ChatFolderBadge" Visibility="Collapsed" Background="#f0f3fb" BorderBrush="#dfe5f2" BorderThickness="1" CornerRadius="12" Padding="8,3" AutomationProperties.Name="Conversation folder"><TextBlock x:Name="ChatFolderBadgeText" Text="Folder" FontSize="11" Foreground="#53617c" /></Border>
          <Border x:Name="TemporaryBadge" Visibility="Collapsed" Background="#fff5e6" BorderBrush="#f1dfc2" BorderThickness="1" CornerRadius="12" Padding="8,3"><TextBlock Text="Temporary · not saved" FontSize="11" Foreground="#805d2c" /></Border>
          <StackPanel x:Name="BranchControls" Visibility="Collapsed" Orientation="Horizontal" Spacing="3" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Conversation branch controls">
            <Button x:Name="PreviousBranchButton" Content="‹" Width="26" Height="26" Padding="0" Click="PreviousBranchClick" AutomationProperties.Name="Previous conversation branch" />
            <TextBlock x:Name="BranchPositionText" Text="1 / 1" VerticalAlignment="Center" FontSize="11" Foreground="#536a70" AutomationProperties.Name="Conversation branch position" />
            <Button x:Name="NextBranchButton" Content="›" Width="26" Height="26" Padding="0" Click="NextBranchClick" AutomationProperties.Name="Next conversation branch" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Click="SettingsClick" Background="{StaticResource SurfaceAltBrush}" Foreground="{StaticResource MutedInkBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="9,4" ToolTipService.ToolTip="Model connection settings" AutomationProperties.Name="Model connection settings">
            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse x:Name="HeaderConnectionDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" /><TextBlock x:Name="HeaderConnectionLabel" Text="Checking" FontSize="11" /></StackPanel>
          </Button>
          <!-- Header shortcut for a new chat (handy when the sidebar is collapsed). It was labelled
               "Add window" but never opened a window, so it is now named for what it does. -->
          <Button Click="NewChatClick" Style="{StaticResource ContextButtonStyle}" Padding="8,6" ToolTipService.ToolTip="New chat" AutomationProperties.Name="Start a new chat" AutomationProperties.HelpText="Start a fresh chat in the current workspace."><FontIcon Glyph="&#xE710;" FontSize="12" /></Button>
        </StackPanel>
      </Grid>

      <Border x:Name="CodingWorkspaceBar" Grid.Row="1" Visibility="Collapsed" Background="#fafcfb" BorderBrush="#e7edeb" BorderThickness="0,0,0,1" Padding="22,9">
        <Grid x:Name="CodingWorkspaceToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" SizeChanged="CodingWorkspaceToolbarSizeChanged">
          <StackPanel x:Name="CodingWorkspaceSummary" Spacing="2" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="⌂" FontSize="15" Foreground="#15849a" VerticalAlignment="Center" />
              <TextBlock x:Name="WorkspaceProjectName" Grid.Column="1" Text="Choose a project" FontSize="13" FontWeight="SemiBold" Foreground="#273a3d" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="2" Background="#edf5f2" CornerRadius="10" Padding="7,2" VerticalAlignment="Center"><TextBlock x:Name="WorkspaceFolderCount" Text="No folders" FontSize="10" Foreground="#527068" /></Border>
            </Grid>
            <TextBlock x:Name="WorkspaceProjectPath" Text="Select a local folder to give the Coding Agent project context." FontSize="11" Foreground="#7b8b8d" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Grid x:Name="CodingWorkspaceActions" Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <Grid x:Name="CodingWorkspaceProjectActions" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
              <Button x:Name="ProjectFoldersButton" Content="Choose project" Click="ProjectFoldersClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Choose or manage project folders" AutomationProperties.HelpText="Select a Coding Agent project or choose its local source folders." />
              <Button x:Name="GitHubActionsButton" Grid.Column="1" Content="Commit / push" Visibility="Collapsed" Click="GitHubActionsClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Review GitHub changes and commit or push" AutomationProperties.HelpText="Review changed project files, create a commit, or push the current branch." />
            </Grid>
            <Grid x:Name="CodingWorkspaceTools" Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
              <Button x:Name="TerminalButton" Content="Terminal" Visibility="Collapsed" Click="OpenTerminalClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Open project terminal" AutomationProperties.HelpText="Open a terminal at the active local project folder." />
              <Button x:Name="UndoHistoryButton" Grid.Column="1" Content="Undo history" Click="UndoHistoryClick" Style="{StaticResource ContextButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="Review approved project file changes and undo" AutomationProperties.HelpText="Review changes the Coding Agent applied and restore an earlier file version." />
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="2" x:Name="ChatSurface" RowDefinitions="*,Auto" Background="{StaticResource SurfaceBrush}">
        <StackPanel x:Name="WelcomePanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Spacing="14" MaxWidth="660" Margin="28,28,28,20">
          <TextBlock Text="◈" FontSize="29" Foreground="#20a9c0" HorizontalAlignment="Center" />
          <TextBlock x:Name="WelcomeTitle" Text="What can I help you with?" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#26373d" />
          <TextBlock x:Name="WelcomeSubtitle" Text="Chat with a model running on your computer, or turn on web search when you need current sources." FontSize="15" TextWrapping="Wrap" Foreground="#74858a" HorizontalAlignment="Center" TextAlignment="Center" />
          <Button x:Name="ConnectionSetupButton" Content="Connect a model" Click="SettingsClick" Style="{StaticResource PrimaryActionButtonStyle}" HorizontalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Connect a model" AutomationProperties.HelpText="Open connection settings to choose and check a local or hosted model endpoint." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,0">
            <Button x:Name="SuggestionOne" Content="Help me write" Click="SuggestionClick" Tag="Help me write" Style="{StaticResource SuggestionButtonStyle}" AutomationProperties.Name="Use writing prompt suggestion" />
            <Button x:Name="SuggestionTwo" Content="Plan a project" Click="SuggestionClick" Tag="Help me plan a project" Style="{StaticResource SuggestionButtonStyle}" AutomationProperties.Name="Use project planning prompt suggestion" />
            <Button x:Name="SuggestionThree" Content="Search the web" Click="SuggestionClick" Tag="Search the web for " Style="{StaticResource SuggestionButtonStyle}" AutomationProperties.Name="Use web search prompt suggestion" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="0" x:Name="ConversationScroll" Visibility="Collapsed" Padding="28,20">
          <StackPanel x:Name="ConversationMessages" Spacing="18" MaxWidth="860" HorizontalAlignment="Center" />
        </ScrollViewer>

      <!-- Composer column: stretches to a fixed reading width (matches the message column) so it
           no longer shrinks to its content or jumps when the status banner or Tools row appear. -->
      <StackPanel Grid.Row="1" MaxWidth="{StaticResource ComposerMaxWidth}" HorizontalAlignment="Stretch" Margin="24,0,24,18">
        <StackPanel x:Name="AttachmentList" Visibility="Collapsed" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8" />
        <Border x:Name="RuntimeStatusBanner" Visibility="Collapsed" Background="#f3f8f9" BorderBrush="#dce8ea" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock x:Name="RuntimeStatus" Text="" FontSize="12" Foreground="#526a70" VerticalAlignment="Center" TextWrapping="Wrap" MaxHeight="72" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="1" Content="×" Click="DismissRuntimeStatusClick" Background="Transparent" Foreground="#60777d" BorderThickness="0" Padding="6,2" AutomationProperties.Name="Dismiss status message" />
          </Grid>
        </Border>
        <Grid x:Name="ComposerToolbar" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,8" SizeChanged="ComposerToolbarSizeChanged">
          <Grid x:Name="PrimaryComposerToolbar" ColumnDefinitions="Auto,Auto">
            <Button x:Name="ModelButton" Content="◉　Ollama　·　llama3.2　⌄" Click="ModelHotswapClick" Style="{StaticResource ContextButtonStyle}" AutomationProperties.Name="Switch pinned model" AutomationProperties.HelpText="Choose a pinned model for this chat. Use Manage models to pin or unpin models." />
            <Button x:Name="ComposerToolsButton" Grid.Column="1" Content="Tools　⌄" Click="ComposerToolsClick" Style="{StaticResource ContextButtonStyle}" Margin="8,0,0,0" HorizontalAlignment="Right" AutomationProperties.Name="Open composer tools" AutomationProperties.HelpText="Show optional composer controls such as web search, temporary chat, project files, and smart rewriting." />
          </Grid>
          <Grid x:Name="SecondaryComposerToolbar" Grid.Column="1" Visibility="Collapsed" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <Button x:Name="WebSearchButton" Content="⌕　Web off" Click="WebSearchClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" AutomationProperties.Name="Toggle web search" AutomationProperties.HelpText="Turn optional DuckDuckGo web search on or off. Search result excerpts and your prompt are sent to the selected model server." />
            <Button x:Name="TemporaryButton" Grid.Column="1" Content="◌　Temporary off" Click="TemporaryClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" AutomationProperties.Name="Toggle temporary chat" AutomationProperties.HelpText="Start or end a temporary chat. Temporary messages are kept only in memory and are not written to Recents or local history." />
            <Button x:Name="ProjectFilesButton" Grid.Column="2" Content="▤　Project files off" Click="ProjectFilesClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Toggle project files in Chat" AutomationProperties.HelpText="Include or exclude bounded, secret-filtered excerpts from the active project's selected folders. A remote model requires consent before files are sent." />
            <Button x:Name="CancelEditButton" Grid.Column="3" Content="Cancel edit" Click="CancelEditClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Cancel editing this message" />
            <Button x:Name="SmartRewriteButton" Grid.Column="4" Content="✦　Rewrite off" Click="SmartRewriteClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" AutomationProperties.Name="Toggle smart prompt rewriting" AutomationProperties.HelpText="Ask the selected model to rewrite your draft using the conversation context before sending. You review the rewrite before it is sent." />
            <Button Grid.Column="5" Content="Image studio" Click="ImageStudioClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" AutomationProperties.Name="Open local image studio" AutomationProperties.HelpText="Generate images with your configured local ComfyUI workflow." />
            <Button Grid.Column="6" Content="Advanced" Click="AdvancedClick" Style="{StaticResource ContextButtonStyle}" Margin="6,0,0,0" AutomationProperties.Name="Open advanced generation controls" AutomationProperties.HelpText="Adjust response temperature and reset it to the recommended value." />
          </Grid>
        </Grid>
        <Border x:Name="CommandHintPanel" Visibility="Collapsed" Background="#ffffff" BorderBrush="#dce8ea" BorderThickness="1" CornerRadius="12" Padding="6" Margin="0,0,0,8">
          <StackPanel Spacing="4">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="CommandSuggestions" Spacing="2" />
            </ScrollViewer>
            <TextBlock Text="↑ ↓ navigate　·　Enter complete　·　Esc close" FontSize="10" Foreground="#7a8e94" Margin="8,2,8,3" />
          </StackPanel>
        </Border>
        <Border x:Name="ComposerBorder" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="17" Padding="14,10">
          <Grid RowDefinitions="Auto,Auto">
            <!-- The composer card shows focus (accent border, see ComposerFocusChanged); the inner
                 TextBox's own focused/hover background and underline are made transparent so it no
                 longer draws a second box inside the card. -->
            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="132" MaxHeight="320" PlaceholderText="Ask anything…" Background="Transparent" BorderThickness="0" Foreground="{StaticResource InkBrush}" TextChanged="PromptTextChanged" GotFocus="ComposerGotFocus" LostFocus="ComposerLostFocus" AutomationProperties.Name="Message composer" AutomationProperties.HelpText="Write a message. Press Enter to send, Shift+Enter for a new line, or Control+L from anywhere to focus this composer.">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource InkColor}" />
              </TextBox.Resources>
            </TextBox>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,8,0,0">
              <!-- Composer actions use one icon font (Fluent symbols ship with Uno) at one size, each
                   with a tooltip; the old mix of ＋ / ♩ 🔊 text glyphs had different sizes and meanings. -->
              <Button Click="AttachClick" Style="{StaticResource ComposerIconButtonStyle}" ToolTipService.ToolTip="Attach files (text, code, PDF, PNG or JPEG)" AutomationProperties.Name="Attach a file"><FontIcon Glyph="&#xE723;" FontSize="15" /></Button>
              <Button Grid.Column="1" Content="/" FontSize="15" FontWeight="SemiBold" Click="CommandsClick" Style="{StaticResource ComposerIconButtonStyle}" Margin="4,0,0,0" ToolTipService.ToolTip="Slash commands" AutomationProperties.Name="Slash commands" />
              <Button Grid.Column="2" x:Name="VoiceButton" Click="VoiceInputClick" Style="{StaticResource ComposerIconButtonStyle}" Margin="4,0,0,0" ToolTipService.ToolTip="Dictate a message" AutomationProperties.Name="Speak a message" AutomationProperties.HelpText="Use the system speech recognizer to dictate a message for any selected model."><FontIcon x:Name="VoiceButtonIcon" Glyph="&#xE720;" FontSize="15" /></Button>
              <Button Grid.Column="3" x:Name="VoiceOutputButton" Click="VoiceOutputClick" Style="{StaticResource ComposerIconButtonStyle}" Margin="4,0,0,0" ToolTipService.ToolTip="Read replies aloud: off" AutomationProperties.Name="Toggle spoken responses" AutomationProperties.HelpText="Read completed model responses aloud using the system speech synthesizer."><FontIcon x:Name="VoiceOutputIcon" Glyph="&#xE74F;" FontSize="15" /></Button>
              <TextBlock Grid.Column="4" x:Name="ProcessingLabel" Text="● Local model" Foreground="{StaticResource MutedInkBrush}" FontSize="{StaticResource CaptionFontSize}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,12,0" />
              <Button x:Name="StopButton" Grid.Column="5" Click="StopClick" Background="{StaticResource DangerBrush}" Foreground="White" CornerRadius="10" Width="34" Height="34" Padding="0" Visibility="Collapsed" ToolTipService.ToolTip="Stop generating" AutomationProperties.Name="Stop generating response"><FontIcon Glyph="&#xE71A;" FontSize="13" /></Button>
              <Button x:Name="SendButton" Grid.Column="5" Click="SendClick" Style="{StaticResource PrimaryActionButtonStyle}" Padding="0" Width="34" Height="34" ToolTipService.ToolTip="Send (Enter)" AutomationProperties.Name="Send message"><FontIcon Glyph="&#xE724;" FontSize="14" /></Button>
            </Grid>
          </Grid>
        </Border>
        <TextBlock x:Name="PrivacyFootnote" Text="Your prompt goes to the model server shown above. Web search is off until you enable it." FontSize="11" Foreground="#8b999d" HorizontalAlignment="Center" Margin="0,9,0,0" TextAlignment="Center" />
      </StackPanel>
      </Grid>
    </Grid>
    <Button x:Name="SidebarBackdrop" Grid.Column="0" Grid.ColumnSpan="2" Background="#66000000" BorderThickness="0" Visibility="Collapsed" Click="CloseSidebarClick" AutomationProperties.Name="Close navigation menu" />
    <Canvas x:Name="CompanionOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Loaded="CompanionOverlayLoaded" SizeChanged="CompanionOverlaySizeChanged">
      <Border x:Name="CompanionCard" Width="230" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="Pet companion">
        <StackPanel HorizontalAlignment="Center" Spacing="4">
          <TextBlock x:Name="CompanionSpeech" Text="Ready for your next prompt." FontSize="11" Foreground="#28474e" TextWrapping="Wrap" MaxWidth="210" HorizontalAlignment="Center" AutomationProperties.Name="Pet completion summary" />
          <Grid Width="84" Height="84" HorizontalAlignment="Center">
            <Image x:Name="CompanionImage" Width="72" Height="72" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" IsTabStop="True" ImageFailed="CompanionImageFailed" KeyDown="CompanionKeyDown" PointerPressed="CompanionPointerPressed" PointerMoved="CompanionPointerMoved" PointerReleased="CompanionPointerReleased" PointerCaptureLost="CompanionPointerCaptureLost" AutomationProperties.Name="Move companion sprite" AutomationProperties.HelpText="Drag the sprite to move it, or focus it and use the arrow keys. Hold Shift to move farther." />
