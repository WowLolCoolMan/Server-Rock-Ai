<UserControl x:Class="ServerRock.Native.SplitConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource SurfaceBrush}"
             AutomationProperties.Name="Split chat view">
  <Grid x:Name="Root" Padding="18,14,18,10" Background="{StaticResource SurfaceBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="36" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource WorkspaceFrameStyle}" Padding="14,12,14,10">
      <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="CurrentTitle" Text="Current chat" FontSize="{StaticResource ReadingFontSize}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Current split chat title" />
        <ScrollViewer Grid.Row="1" x:Name="CurrentScroll" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="CurrentMessages" Spacing="10" />
        </ScrollViewer>
      </Grid>
    </Border>

    <Border x:Name="SplitRatioGutter" Grid.Column="1" Margin="10,0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="2" PointerPressed="SplitRatioGutterPressed" PointerMoved="SplitRatioGutterMoved" PointerReleased="SplitRatioGutterReleased" PointerCaptureLost="SplitRatioGutterCaptureLost" AutomationProperties.Name="Drag split pane divider" AutomationProperties.HelpText="Drag the divider left or right to resize the current and comparison chat panes. The ratio is saved for this workspace.">
      <Grid>
        <Slider x:Name="SplitRatioSlider" Orientation="Vertical" Minimum="25" Maximum="75" Value="50" StepFrequency="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="180" Width="24" ValueChanged="SplitRatioChanged" AutomationProperties.Name="Split pane ratio" AutomationProperties.HelpText="Use the arrow keys or drag the slider to resize the current and comparison chat panes. The ratio is saved for this workspace." />
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource WorkspaceFrameStyle}" Padding="14,12,14,10">
      <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock x:Name="ComparisonTitle" Text="Compare another chat" FontSize="{StaticResource ReadingFontSize}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" AutomationProperties.Name="Comparison split chat title" />
        <ComboBox x:Name="ComparisonPicker" Grid.Row="1" Margin="0,8,0,0" PlaceholderText="Choose a saved chat" SelectionChanged="ComparisonPickerChanged" AutomationProperties.Name="Choose comparison chat" AutomationProperties.HelpText="Select a saved conversation to show beside the current chat." />
        <TextBlock x:Name="ComparisonEmpty" Grid.Row="2" Text="Save another conversation to compare it here." TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Comparison chat empty state" />
        <ScrollViewer x:Name="ComparisonScroll" Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ComparisonMessages" Spacing="10" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
