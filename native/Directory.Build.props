<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Adding NoWarn to remove build warnings
      NU1507: Warning when there are multiple package sources when using CPM with no source mapping
      NETSDK1201: Warning that specifying RID won't create self containing app
      PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>

    <!-- Uno 6.7 still imports its DevServer validation target into the release
         graph. Keep release/publish builds buildable until that SDK package is
         upgraded to honor conditional DevServer assets. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">false</Optimize>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">false</PublishTrimmed>
  </PropertyGroup>
</Project>
