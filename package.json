{
  "name": "server-rock-ai",
  "version": "0.1.1",
  "description": "A local-first desktop AI workspace with pluggable model providers",
  "author": "Server Rock",
  "license": "MIT",
  "private": false,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:linux": "electron-builder --linux AppImage deb tar.gz --publish never",
    "build:mac": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.server-rock.ai",
    "productName": "Server Rock: AI",
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "commands.js",
      "runtime/**/*",
      "electron/**/*",
      "README.md",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/@huggingface/tokenizers/**/*",
      "node_modules/@huggingface/jinja/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-web/**/*",
      "node_modules/sharp/**/*",
      "node_modules/marked/**/*",
      "node_modules/dompurify/dist/**/*",
      "node_modules/dompurify/LICENSE*",
      "THIRD_PARTY_NOTICES.md",
      "docs/OPEN_WEBUI_RESEARCH.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Server Rock: AI",
      "uninstallDisplayName": "Server Rock: AI",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "dompurify": "^3.4.17",
    "jose": "^6.2.15",
    "marked": "^18.1.3"
  }
}
