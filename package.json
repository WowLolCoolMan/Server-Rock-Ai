{
  "name": "server-rock-ai",
  "version": "0.1.2",
  "description": "A local-first desktop AI workspace with pluggable model providers",
  "author": "Server Rock",
  "license": "MIT",
  "private": false,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check:syntax": "node --check app.js && node --check commands.js && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/github-updates.cjs && node --check electron/provider-bridge.cjs && node --check electron/workspace.cjs && node --check electron/ipc-validation.cjs && node --check electron/bounded-file.cjs && node --check electron/terminal-sessions.cjs && node --check scripts/audit-ui.cjs && node --check scripts/audit-electron.cjs",
    "check:hygiene": "node scripts/check-repo-hygiene.cjs",
    "audit:ui": "node scripts/audit-ui.cjs",
    "audit:electron": "node scripts/audit-electron.cjs",
    "audit:electron:packaged": "node scripts/audit-electron.cjs",
    "test": "node --test tests/github-updates.test.cjs && playwright test",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win nsis portable --publish never",
    "build:linux": "electron-builder --linux AppImage deb tar.gz --publish never",
    "build:mac": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.server-rock.ai",
    "productName": "Server Rock: AI",
    "compression": "normal",
    "artifactName": "Server-Rock-AI-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "commands.js",
      "runtime/**/*",
      "electron/**/*",
      "assets/pets/**/*.svg",
      "README.md",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/@huggingface/tokenizers/**/*",
      "node_modules/@huggingface/jinja/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/onnxruntime-web/**/*",
      "node_modules/sharp/**/*",
      "node_modules/marked/**/*",
      "node_modules/dompurify/dist/**/*",
      "node_modules/dompurify/LICENSE*",
      "THIRD_PARTY_NOTICES.md",
      "docs/**/*.md"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Server Rock: AI",
      "uninstallDisplayName": "Server Rock: AI",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Server-Rock-AI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Server-Rock-AI-${version}-portable.${ext}"
    },
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "WowLolCoolMan",
      "repo": "Server-Rock-Ai",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "jose": "^6.2.15",
    "marked": "^18.1.3"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": false,
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
